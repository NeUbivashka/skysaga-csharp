@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="() => _drawerOpen = !_drawerOpen" />
        <MudIcon Icon="@Icons.Material.Filled.Cloud" Class="ml-2 mr-2" Style="color:#7dd3fc" />
        <MudText Typo="Typo.h6" Class="brand">SkySaga Control</MudText>
        <MudSpacer />
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Icon="@Icons.Material.Filled.Storage">Alpha 10 · 36731</MudChip>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="DrawerVariant.Mini" OpenMiniOnHover="true">
        <MudNavMenu Class="mt-2">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SpaceDashboard">Overview</MudNavLink>
            <MudNavLink Href="/players" Icon="@Icons.Material.Filled.People">Players</MudNavLink>
            <MudNavLink Href="/accounts" Icon="@Icons.Material.Filled.ManageAccounts">Accounts</MudNavLink>
            <MudNavLink Href="/worlds" Icon="@Icons.Material.Filled.Public">Worlds</MudNavLink>
            <MudNavLink Href="/events" Icon="@Icons.Material.Filled.Timeline">Events</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen;

    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#38bdf8",
            Secondary = "#fbbf24",
            Tertiary = "#a78bfa",
            Info = "#7dd3fc",
            Success = "#34d399",
            Warning = "#fbbf24",
            Error = "#f87171",
            Background = "#0b1120",
            Surface = "#111a2e",
            AppbarBackground = "#0d1528",
            AppbarText = "#e2e8f0",
            DrawerBackground = "#0d1528",
            DrawerText = "#cbd5e1",
            DrawerIcon = "#7dd3fc",
            TextPrimary = "#e2e8f0",
            TextSecondary = "#94a3b8",
            LinesDefault = "rgba(148,163,184,0.14)",
            TableLines = "rgba(148,163,184,0.10)",
            ActionDefault = "#94a3b8"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Inter", "system-ui", "sans-serif"] }
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "10px" }
    };
}
