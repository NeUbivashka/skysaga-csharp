@page "/"
@inherits LivePage
@inject IDbContextFactory<SkySagaDbContext> Db

<PageTitle>Overview · SkySaga Control</PageTitle>

<div class="page-header">
    <div>
        <div class="eyebrow">Alpha 10 · build 36731</div>
        <h1 class="page-title">@Greeting</h1>
        <Motto />
    </div>
    <div class="header-actions">
        <MudButton Href="/live" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sensors" Class="glow-button">Live view</MudButton>
        <MudButton Href="/events" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Timeline">Events</MudButton>
    </div>
</div>

@if (Live.Error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">Database: @Live.Error</MudAlert>
}

<div class="kpi-grid">
    <div class="kpi kpi-hero" style="--accent:#34d399">
        <div class="kpi-head"><span class="kpi-icon"><MudIcon Icon="@Icons.Material.Filled.Sensors" /></span>Online now</div>
        <div class="kpi-value">@Live.Online.Count</div>
        <div class="kpi-foot">peak @Live.PeakOnline since the panel started</div>
        <div class="kpi-spark"><Sparkline Values="Live.OnlineHistory" Color="#34d399" /></div>
    </div>
    <div class="kpi" style="--accent:#38bdf8">
        <div class="kpi-head"><span class="kpi-icon"><MudIcon Icon="@Icons.Material.Filled.Badge" /></span>Accounts</div>
        <div class="kpi-value">@Live.Accounts.ToString("N0")</div>
        <div class="kpi-foot"><span class="delta up">+@Live.NewAccountsWeek</span> this week</div>
    </div>
    <div class="kpi" style="--accent:#a78bfa">
        <div class="kpi-head"><span class="kpi-icon"><MudIcon Icon="@Icons.Material.Filled.Person" /></span>Characters</div>
        <div class="kpi-value">@Live.Characters.ToString("N0")</div>
        <div class="kpi-foot">@Live.Friendships.ToString("N0") friendships</div>
    </div>
    <div class="kpi" style="--accent:#fbbf24">
        <div class="kpi-head"><span class="kpi-icon"><MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" /></span>VIP</div>
        <div class="kpi-value">@Live.PremiumActive.ToString("N0")</div>
        <div class="kpi-foot">@Live.PremiumForever forever · @Live.Banned banned</div>
    </div>
    <div class="kpi" style="--accent:#22d3ee">
        <div class="kpi-head"><span class="kpi-icon"><MudIcon Icon="@Icons.Material.Filled.Public" /></span>Worlds</div>
        <div class="kpi-value">@Live.Worlds.ToString("N0")</div>
        <div class="kpi-foot">@Island islands · @Live.Photos.ToString("N0") photos</div>
    </div>
    <div class="kpi" style="--accent:#fb923c">
        <div class="kpi-head"><span class="kpi-icon"><MudIcon Icon="@Icons.Material.Filled.ViewInAr" /></span>Builds</div>
        <div class="kpi-value">@Live.VoxelEdits.ToString("N0")</div>
        <div class="kpi-foot">voxel edits · @Live.Devices.ToString("N0") devices placed</div>
    </div>
    <div class="kpi" style="--accent:#f472b6">
        <div class="kpi-head"><span class="kpi-icon"><MudIcon Icon="@Icons.Material.Filled.Bolt" /></span>Events, 24 h</div>
        <div class="kpi-value">@Live.EventsDay.ToString("N0")</div>
        <div class="kpi-foot">@Live.EventsHour.ToString("N0") in the last hour</div>
    </div>
</div>

<MudGrid Spacing="3" Class="mt-1">
    <MudItem xs="12" lg="8">
        <div class="glass-card">
            <div class="card-head">
                <div>
                    <div class="card-title">Activity</div>
                    <div class="card-sub">Game events per hour, last 24 hours</div>
                </div>
                <span class="chip-soft">@Live.EventsDay.ToString("N0") total</span>
            </div>
            <AreaChart Values="Live.ActivityPerHour" Labels="Live.HourLabels" Color="#38bdf8" SecondColor="#a78bfa" Unit="events" LabelEvery="3" Height="250" />
        </div>
    </MudItem>
    <MudItem xs="12" lg="4">
        <div class="glass-card full">
            <div class="card-head">
                <div>
                    <div class="card-title">Where players are</div>
                    <div class="card-sub">Online players by world</div>
                </div>
            </div>
            @if (Live.OnlineByWorld.Count == 0)
            {
                <div class="empty-state">
                    <MudIcon Icon="@Icons.Material.Filled.NightsStay" Size="Size.Large" />
                    <div>Nobody is online right now.</div>
                </div>
            }
            else
            {
                <DonutChart Slices="Live.OnlineByWorld" CenterLabel="online" Title="Online players by world" />
            }
        </div>
    </MudItem>

    <MudItem xs="12" sm="6" lg="3">
        <div class="glass-card full">
            <div class="card-title">Account status</div>
            <div class="card-sub mb-3">Active, VIP, banned and locked</div>
            <DonutChart Slices="Live.AccountStatus" CenterLabel="accounts" Size="160" />
        </div>
    </MudItem>
    <MudItem xs="12" sm="6" lg="3">
        <div class="glass-card full">
            <div class="card-title">Roles</div>
            <div class="card-sub mb-3">Players, game masters and admins</div>
            <DonutChart Slices="Live.Roles" CenterLabel="accounts" Size="160" />
        </div>
    </MudItem>
    <MudItem xs="12" sm="6" lg="3">
        <div class="glass-card full">
            <div class="card-title">Worlds by kind</div>
            <div class="card-sub mb-3">Saved worlds in the database</div>
            <DonutChart Slices="Live.WorldKinds" CenterLabel="worlds" Size="160" />
        </div>
    </MudItem>
    <MudItem xs="12" sm="6" lg="3">
        <div class="glass-card full">
            <div class="card-title">Event mix</div>
            <div class="card-sub mb-3">Kinds of events, last 24 hours</div>
            <DonutChart Slices="Live.EventKinds" CenterLabel="events" Size="160" />
        </div>
    </MudItem>

    <MudItem xs="12" lg="6">
        <div class="glass-card full">
            <div class="card-head">
                <div>
                    <div class="card-title">New accounts</div>
                    <div class="card-sub">Registrations per day, last 14 days</div>
                </div>
                <span class="chip-soft">+@Live.NewAccountsWeek this week</span>
            </div>
            <BarChart Values="Live.RegistrationsPerDay" Labels="Live.DayLabels" Color="#a78bfa" SecondColor="#38bdf8" Unit="accounts" LabelEvery="2" />
        </div>
    </MudItem>
    <MudItem xs="12" lg="6">
        <div class="glass-card full">
            <div class="card-title">Most held items</div>
            <div class="card-sub mb-3">Summed over every inventory</div>
            @if (Live.TopItems.Count == 0)
            {
                <div class="empty-state">No items yet.</div>
            }
            @for (var i = 0; i < Live.TopItems.Count; i++)
            {
                var item = Live.TopItems[i];
                var color = LiveMetrics.Palette[i % LiveMetrics.Palette.Length];
                <div class="rank-row">
                    <span class="rank-index">@(i + 1)</span>
                    <div class="rank-body">
                        <div class="rank-line"><span>@item.Name</span><span class="mono">@item.Count.ToString("N0")</span></div>
                        <div class="meter"><span style="width:@ChartGeometry.Number(100.0 * item.Count / Live.TopItems[0].Count)%;background:linear-gradient(90deg,@color,@(color)66)"></span></div>
                    </div>
                </div>
            }
        </div>
    </MudItem>

    <MudItem xs="12" lg="7">
        <div class="glass-card full">
            <div class="card-head">
                <div>
                    <div class="card-title">Live feed</div>
                    <div class="card-sub">Newest game and admin events</div>
                </div>
                <span class="pill live small"><span class="pulse"></span>streaming</span>
            </div>
            <div class="feed">
                @foreach (var item in Live.RecentEvents.Take(12))
                {
                    <div class="feed-item" @key="item.Id">
                        <span class="feed-icon" style="--accent:@Format.EventColor(item.Kind)"><MudIcon Icon="@Format.EventIcon(item.Kind)" Size="Size.Small" /></span>
                        <div class="feed-body">
                            <div class="feed-line">
                                <span class="feed-kind" style="color:@Format.EventColor(item.Kind)">@item.Kind</span>
                                @if (item.CharacterId is Guid id)
                                {
                                    <a href="/players/@id" class="feed-who">@(item.Character ?? "unknown")</a>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(item.Data))
                            {
                                <div class="feed-data mono">@item.Data</div>
                            }
                        </div>
                        <span class="feed-time">@Format.Ago(item.Time)</span>
                    </div>
                }
                @if (Live.RecentEvents.Count == 0)
                {
                    <div class="empty-state">No events yet.</div>
                }
            </div>
        </div>
    </MudItem>
    <MudItem xs="12" lg="5">
        <div class="glass-card">
            <div class="card-title">Services</div>
            <div class="card-sub mb-3">Checked every six seconds</div>
            <div class="service-grid">
                @foreach (var service in Live.Services)
                {
                    <div class="service-card @(service.Up ? "up" : "down")">
                        <span class="dot @(service.Up ? "up" : "down")"></span>
                        <div>
                            <div class="service-title">@service.Name</div>
                            <div class="service-address mono">@service.Address</div>
                        </div>
                        <div class="service-state mono">@(service.Up ? $"{service.LatencyMs:0.0} ms" : "down")</div>
                    </div>
                }
                <div class="service-card up">
                    <span class="dot up"></span>
                    <div>
                        <div class="service-title">PostgreSQL</div>
                        <div class="service-address mono">EF Core</div>
                    </div>
                    <div class="service-state mono">@Live.DbLatencyMs.ToString("0.0") ms</div>
                </div>
            </div>
        </div>

        <div class="glass-card mt-3">
            <div class="card-title">Recently seen</div>
            <div class="card-sub mb-2">Last characters in the game</div>
            @foreach (var row in _recent)
            {
                <a class="person-row" href="/players/@row.Id">
                    <Avatar Name="@row.Name" Size="sm" Photo="@Live.AvatarOf(row.Id)" Online="@(Live.Online.Any(p => p.Id == row.Id))" />
                    <div class="person-body">
                        <div class="person-name">@row.Name</div>
                        <div class="person-sub">@row.Account · rank @row.Rank</div>
                    </div>
                    <span class="feed-time">@Format.Ago(row.LastSeen)</span>
                </a>
            }
            @if (_recent.Count == 0)
            {
                <div class="empty-state">No characters yet.</div>
            }
        </div>
    </MudItem>
</MudGrid>

@code {
    private sealed record RecentRow(Guid Id, string Name, string Account, int Rank, DateTimeOffset? LastSeen);

    private List<RecentRow> _recent = [];
    private DateTimeOffset _recentLoaded;

    private double Island => Live.WorldKinds.FirstOrDefault(k => k.Label == nameof(WorldKind.Island))?.Value ?? 0;

    private static string Greeting => DateTime.Now.Hour switch
    {
        < 5 => "Good night",
        < 12 => "Good morning",
        < 18 => "Good afternoon",
        _ => "Good evening"
    };

    protected override Task OnInitializedAsync() => LoadRecentAsync();

    protected override async Task OnLiveChangedAsync()
    {
        if (DateTimeOffset.UtcNow - _recentLoaded > TimeSpan.FromSeconds(10))
            await LoadRecentAsync();
    }

    private async Task LoadRecentAsync()
    {
        await using var db = await Db.CreateDbContextAsync();

        _recent = await db.Characters.AsNoTracking().Where(c => c.LastSeenAt != null).OrderByDescending(c => c.LastSeenAt).Take(6)
            .Select(c => new RecentRow(c.Id, c.Name, c.Account!.Username,
                c.Jobs.Where(j => j.Name == "Unified").Select(j => (int)j.Rank).FirstOrDefault(), c.LastSeenAt))
            .ToListAsync();
        _recentLoaded = DateTimeOffset.UtcNow;
    }
}
