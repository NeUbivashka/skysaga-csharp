@page "/players/{Id:guid}"
@inherits LivePage
@inject IDbContextFactory<SkySagaDbContext> Db
@inject GameNames Names
@inject PlayerStats Stats
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject AccountActions Actions
@inject AuthLinks Links

<PageTitle>@(_character?.Name ?? "Player") · SkySaga Control</PageTitle>

@if (_character is null || _account is null)
{
    <div class="empty-state large"><MudProgressCircular Indeterminate="true" /></div>
    return;
}

<div class="profile-hero">
    <div class="profile-hero-bg" style="@HeroBackground"></div>
    <div class="profile-hero-content">
        <Avatar Name="@_character.Name" Size="xl" Photo="@Live.AvatarOf(_character.Id)" Online="@(Online is not null)" />
        <div class="profile-hero-text">
            <h1 class="page-title">@_character.Name</h1>
            <div class="profile-tags">
                <span class="tag">@_account.Username</span>
                <span class="tag @(_account.Role switch { AccountRole.Admin => "pink", AccountRole.GameMaster => "violet", _ => "" })">@_account.Role</span>
                @if (Forever.Is(_account.PremiumUntil))
                {
                    <span class="vip-badge forever">∞ VIP forever</span>
                }
                else if (_account.PremiumUntil > DateTimeOffset.UtcNow)
                {
                    <span class="vip-badge">VIP · @Format.Left(_account.PremiumUntil.Value)</span>
                }
                @if (Online is { } online)
                {
                    <span class="tag green"><span class="pulse inline"></span> online · @online.World</span>
                }
                else
                {
                    <span class="tag">last seen @Format.Ago(_character.LastSeenAt)</span>
                }
                @if (_account.BannedUntil > DateTimeOffset.UtcNow)
                {
                    <span class="tag red">banned @(Forever.Is(_account.BannedUntil) ? "permanently" : $"until {Format.Until(_account.BannedUntil)}")</span>
                }
            </div>
            <div class="mono muted-label">@_character.Id</div>
        </div>
        <div class="profile-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.WorkspacePremium" OnClick="EditPremiumAsync" Class="glow-button gold">VIP</MudButton>
            @if (_account.BannedUntil > DateTimeOffset.UtcNow)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.LockOpen" OnClick="UnbanAsync">Lift ban</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Gavel" OnClick="BanAsync">Ban</MudButton>
            }
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                @foreach (var role in Enum.GetValues<AccountRole>().Where(r => r != _account.Role))
                {
                    var target = role;
                    <MudMenuItem Icon="@Icons.Material.Filled.AdminPanelSettings" OnClick="() => SetRoleAsync(target)">Make @target</MudMenuItem>
                }
                <MudMenuItem Icon="@Icons.Material.Filled.Key" OnClick="ResetAsync">Password reset link</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="SignOutAsync">Sign out everywhere</MudMenuItem>
            </MudMenu>
        </div>
    </div>
</div>

@if (_resetLink is not null)
{
    <MudAlert Severity="Severity.Info" Class="mt-3" ShowCloseIcon="true" CloseIconClicked="() => _resetLink = null">
        Reset link, valid for @((int)AccountSecurity.ResetLifetime.TotalHours) hours. It is shown only now:
        <div class="mono mt-1">@_resetLink</div>
    </MudAlert>
}

<div class="stat-strip mt-3">
    <div class="stat-tile"><span class="stat-label">Max health</span><span class="stat-number">@(Stats.MaxHealth > 0 ? Stats.MaxHealth.ToString("N0") : "—") <small>HP</small></span></div>
    <div class="stat-tile"><span class="stat-label">Items</span><span class="stat-number">@_character.Inventory.Sum(i => i.Count).ToString("N0")</span></div>
    <div class="stat-tile"><span class="stat-label">Recipes</span><span class="stat-number">@(_character.KnownRecipes?.Count ?? 0)</span></div>
    <div class="stat-tile"><span class="stat-label">Friends</span><span class="stat-number">@_friends.Count</span></div>
    <div class="stat-tile"><span class="stat-label">Challenges done</span><span class="stat-number">@(_character.CompletedChallenges?.Count ?? 0)</span></div>
    <div class="stat-tile"><span class="stat-label">Member since</span><span class="stat-number small">@_character.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</span></div>
</div>

<MudGrid Spacing="3" Class="mt-1">
    <MudItem xs="12" lg="4">
        <div class="glass-card">
            <div class="card-title mb-2">Jobs</div>
            @if (_jobSlices.Count > 0)
            {
                <DonutChart Slices="_jobSlices" CenterLabel="XP" Size="150" ShowLegend="false" />
            }
            @foreach (var job in _character.Jobs.OrderByDescending(j => j.Experience))
            {
                <div class="rank-row">
                    <span class="rank-index">@job.Rank</span>
                    <div class="rank-body">
                        <div class="rank-line"><span>@job.Name</span><span class="mono">@job.Experience.ToString("N0") XP</span></div>
                        <div class="meter"><span style="width:@ChartGeometry.Number(_maxXp > 0 ? 100.0 * job.Experience / _maxXp : 0)%;background:linear-gradient(90deg,#a78bfa,#38bdf8)"></span></div>
                    </div>
                </div>
            }
        </div>

        <div class="glass-card mt-3">
            <div class="card-title mb-2">Wallet</div>
            <div class="wallet-grid">
                @foreach (var currency in _character.Currencies.OrderByDescending(c => c.Value))
                {
                    <div class="wallet-tile">
                        <span class="wallet-name">@Names.Item(currency.NameHash)</span>
                        <span class="wallet-value mono">@currency.Value.ToString("N0")</span>
                    </div>
                }
            </div>
        </div>

        <div class="glass-card mt-3">
            <div class="card-title mb-2">Position</div>
            <div class="facts-grid">
                <div><span class="stat-label">Map</span><span>@(_character.PositionMap ?? "—")</span></div>
                <div><span class="stat-label">Coordinates</span><span class="mono">@($"{_character.PositionX:0.#}, {_character.PositionY:0.#}, {_character.PositionZ:0.#}")</span></div>
                <div><span class="stat-label">Sigil</span><span>@(_character.CurrentSigil?.ToString() ?? "default")</span></div>
                <div><span class="stat-label">Emotes</span><span>@(_character.AvailableEmotes?.Count ?? 0)</span></div>
            </div>
        </div>
    </MudItem>

    <MudItem xs="12" lg="8">
        <div class="glass-card">
            <div class="card-head">
                <div class="card-title">Inventory</div>
                <span class="chip-soft">@_character.Inventory.Count slots used</span>
            </div>
            <div class="item-grid">
                @foreach (var item in _character.Inventory.OrderBy(i => i.Slot))
                {
                    <div class="item-tile @(item.Slot < 9 ? "equipped" : "")" title="@Names.Item(item.NameHash)">
                        <span class="item-slot">@(item.Slot < 9 ? $"E{item.Slot}" : item.Slot.ToString())</span>
                        <span class="item-name">@Names.Item(item.NameHash)</span>
                        <span class="item-count mono">×@item.Count</span>
                        @if (item.Materials?.OfType<long>().ToList() is { Count: > 0 } materials)
                        {
                            <span class="item-materials">@string.Join(", ", materials.Select(m => Names.Material(m)))</span>
                        }
                    </div>
                }
                @if (_character.Inventory.Count == 0)
                {
                    <div class="empty-state">Empty.</div>
                }
            </div>
        </div>

        <MudGrid Spacing="3" Class="mt-0">
            <MudItem xs="12" md="6">
                <div class="glass-card full">
                    <div class="card-title mb-2">Friends</div>
                    @foreach (var friend in _friends)
                    {
                        <a class="person-row" href="/players/@friend.Id">
                            <Avatar Name="@friend.Name" Size="sm" Photo="@Live.AvatarOf(friend.Id)" Online="@(Live.Online.Any(p => p.Id == friend.Id))" />
                            <div class="person-body">
                                <div class="person-name">@friend.Name</div>
                                <div class="person-sub">friends since @friend.Since.ToLocalTime().ToString("d MMM yyyy")</div>
                            </div>
                        </a>
                    }
                    @if (_friends.Count == 0)
                    {
                        <div class="empty-state">No friends yet.</div>
                    }
                </div>
            </MudItem>
            <MudItem xs="12" md="6">
                <div class="glass-card full">
                    <div class="card-title mb-2">Active challenges</div>
                    @foreach (var challenge in _character.ActiveChallenges)
                    {
                        <div class="rank-line padded"><span>@challenge.Name</span><span class="mono">@challenge.Progress</span></div>
                    }
                    @if (_character.ActiveChallenges.Count == 0)
                    {
                        <div class="empty-state">None.</div>
                    }
                    @if (_worlds.Count > 0)
                    {
                        <div class="card-title mt-4 mb-2">Owned worlds</div>
                        @foreach (var world in _worlds)
                        {
                            <div class="rank-line padded"><span>@world.Kind · @(world.Name ?? world.Template)</span><span class="muted-label">visited @Format.Ago(world.LastVisitedAt)</span></div>
                        }
                    }
                </div>
            </MudItem>
        </MudGrid>

        <div class="glass-card mt-3">
            <div class="card-title mb-2">History</div>
            <div class="timeline">
                @foreach (var item in _events)
                {
                    <div class="timeline-item" style="--accent:@Format.EventColor(item.Kind)">
                        <span class="timeline-dot"><MudIcon Icon="@Format.EventIcon(item.Kind)" Size="Size.Small" /></span>
                        <div class="timeline-body">
                            <div class="feed-line"><span class="feed-kind" style="color:@Format.EventColor(item.Kind)">@item.Kind</span><span class="feed-time">@item.Time.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span></div>
                            @if (!string.IsNullOrEmpty(item.Data))
                            {
                                <div class="feed-data mono">@item.Data</div>
                            }
                        </div>
                    </div>
                }
                @if (_events.Count == 0)
                {
                    <div class="empty-state">No events for this character yet.</div>
                }
            </div>
        </div>
    </MudItem>
</MudGrid>

@code {
    private sealed record FriendRow(Guid Id, string Name, DateTimeOffset Since);

    [Parameter] public Guid Id { get; set; }

    private Character? _character;
    private Account? _account;
    private List<FriendRow> _friends = [];

    private string HeroBackground => Live.AvatarOf(_character!.Id) is { } photo
        ? $"background:url('/avatars/{photo}') center/cover"
        : Format.AvatarGradient(_character.Name);
    private List<World> _worlds = [];
    private List<GameEvent> _events = [];
    private List<Slice> _jobSlices = [];
    private long _maxXp;
    private string? _resetLink;
    private long _lastEvent;

    private OnlinePlayer? Online => Live.Online.FirstOrDefault(p => p.Id == Id);

    protected override Task OnParametersSetAsync() => LoadAsync();

    protected override async Task OnLiveChangedAsync()
    {
        if (Live.RecentEvents.Any(e => e.CharacterId == Id && e.Id > _lastEvent))
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await Db.CreateDbContextAsync();

        _character = await db.Characters.AsNoTracking()
            .Include(c => c.Account)
            .Include(c => c.Inventory)
            .Include(c => c.Jobs)
            .Include(c => c.Currencies)
            .Include(c => c.ActiveChallenges)
            .AsSplitQuery()
            .SingleOrDefaultAsync(c => c.Id == Id);
        _account = _character?.Account;

        if (_character is null)
            return;

        _friends = await db.Friendships.AsNoTracking().Where(f => f.CharacterId == Id)
            .Join(db.Characters, f => f.FriendId, c => c.Id, (f, c) => new { c.Id, c.Name, f.CreatedAt })
            .OrderBy(f => f.Name).Select(f => new FriendRow(f.Id, f.Name, f.CreatedAt)).ToListAsync();
        _worlds = await db.Worlds.AsNoTracking().Where(w => w.OwnerCharacterId == Id).ToListAsync();
        _events = await db.GameEvents.AsNoTracking().Where(e => e.CharacterId == Id).OrderByDescending(e => e.Id).Take(25).ToListAsync();
        _lastEvent = _events.FirstOrDefault()?.Id ?? 0;
        _maxXp = _character.Jobs.Select(j => j.Experience).DefaultIfEmpty(0).Max();
        _jobSlices = [.. _character.Jobs.Where(j => j.Experience > 0).OrderByDescending(j => j.Experience)
            .Select((j, i) => new Slice(j.Name, j.Experience, LiveMetrics.Palette[i % LiveMetrics.Palette.Length]))];
    }

    private async Task EditPremiumAsync()
    {
        if (await Dialogs.EditPremiumAsync(Actions, Snackbar, _account!.Id, _account.Username, _account.PremiumUntil))
            await LoadAsync();
    }

    private async Task BanAsync()
    {
        if (await Dialogs.BanAsync(Actions, Snackbar, _account!.Id, _account.Username))
            await LoadAsync();
    }

    private async Task UnbanAsync()
    {
        await Actions.SetBanAsync(_account!.Id, null, null);
        Snackbar.Add($"Ban of {_account.Username} lifted", Severity.Success);
        await LoadAsync();
    }

    private async Task SetRoleAsync(AccountRole role)
    {
        await Actions.SetRoleAsync(_account!.Id, role);
        Snackbar.Add($"{_account.Username} is now {role}", Severity.Success);
        await LoadAsync();
    }

    private async Task ResetAsync() => _resetLink = Links.Reset(await Actions.CreateResetCodeAsync(_account!.Id));

    private async Task SignOutAsync()
    {
        await Actions.SignOutEverywhereAsync(_account!.Id);
        Snackbar.Add($"{_account.Username} was signed out everywhere", Severity.Success);
    }
}
