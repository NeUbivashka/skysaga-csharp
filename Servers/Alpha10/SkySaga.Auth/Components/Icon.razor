<svg class="icon @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "mail":
            <rect x="3" y="5" width="18" height="14" rx="3" />
            <path d="M3 7l9 6 9-6" />
            break;
        case "user":
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" />
            break;
        case "lock":
            <rect x="4" y="11" width="16" height="10" rx="3" />
            <path d="M8 11V8a4 4 0 0 1 8 0v3" />
            break;
        case "key":
            <circle cx="8" cy="15" r="4" />
            <path d="M11 12l9-9M16 7l3 3M14 9l2 2" />
            break;
        case "eye":
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
            <circle cx="12" cy="12" r="3" />
            break;
        case "shield":
            <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z" />
            <path d="M9 12l2 2 4-4" />
            break;
        case "sparkle":
            <path d="M12 3l2 6 6 2-6 2-2 6-2-6-6-2 6-2z" />
            break;
        case "arrow":
            <path d="M5 12h14M13 6l6 6-6 6" />
            break;
        case "crown":
            <path d="M3 8l4 4 5-7 5 7 4-4-2 11H5z" />
            break;
        case "globe":
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18" />
            break;
        case "users":
            <circle cx="9" cy="8" r="3.5" />
            <path d="M2 20c1-3.5 3.8-5 7-5s6 1.5 7 5" />
            <path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 15c2 .6 3.4 2.2 4 5" />
            break;
        case "launch":
            <path d="M5 19c1-4 3-7 7-11 3-3 6-4 8-4 0 2-1 5-4 8-4 4-7 6-11 7z" />
            <path d="M9 15l-3-3M14 10a1.5 1.5 0 1 0 0-.01" />
            break;
        case "check":
            <path d="M5 12l5 5 9-10" />
            break;
        case "logout":
            <path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 17l-5-5 5-5M5 12h11" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 3" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string? Class { get; set; }
}
