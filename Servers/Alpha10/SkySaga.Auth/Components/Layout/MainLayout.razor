@inherits LayoutComponentBase
@inject AccountService Accounts

<div class="sky" aria-hidden="true">
    <div class="sky-gradient"></div>
    <div class="stars stars-far"></div>
    <div class="stars stars-near"></div>
    <div class="sun"></div>
    <div class="cloud cloud-a"></div>
    <div class="cloud cloud-b"></div>
    <div class="cloud cloud-c"></div>

    <div class="parallax" data-depth="0.6">
        <svg class="isle isle-big" viewBox="0 0 320 300">
            <defs>
                <linearGradient id="grass" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#86efac" /><stop offset="1" stop-color="#22c55e" /></linearGradient>
                <linearGradient id="rock" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#a16207" /><stop offset="1" stop-color="#3f2a12" /></linearGradient>
                <linearGradient id="fall" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7dd3fc" stop-opacity="0.95" /><stop offset="1" stop-color="#7dd3fc" stop-opacity="0" /></linearGradient>
            </defs>
            <path d="M40 120 L160 70 L280 120 L160 170 Z" fill="url(#grass)" />
            <path d="M40 120 L160 170 L160 196 L52 146 Z" fill="#16a34a" />
            <path d="M280 120 L160 170 L160 196 L268 146 Z" fill="#15803d" />
            <path d="M52 146 L160 196 L268 146 L214 230 L160 290 L110 236 Z" fill="url(#rock)" />
            <path d="M110 236 L160 290 L160 196 Z" fill="#000" opacity="0.18" />
            <rect x="196" y="150" width="10" height="120" fill="url(#fall)" class="waterfall" />
            <g class="tree">
                <rect x="104" y="78" width="10" height="36" fill="#7c2d12" />
                <path d="M86 84 L109 42 L132 84 Z" fill="#15803d" />
                <path d="M92 64 L109 30 L126 64 Z" fill="#22c55e" />
            </g>
            <g class="tree small">
                <rect x="196" y="96" width="8" height="24" fill="#7c2d12" />
                <path d="M183 100 L200 70 L217 100 Z" fill="#16a34a" />
            </g>
            <rect x="146" y="98" width="26" height="22" fill="#fbbf24" />
            <path d="M140 100 L159 84 L178 100 Z" fill="#b91c1c" />
        </svg>
    </div>

    <div class="parallax" data-depth="1.2">
        <svg class="isle isle-small" viewBox="0 0 200 180">
            <path d="M20 70 L100 38 L180 70 L100 102 Z" fill="#4ade80" />
            <path d="M20 70 L100 102 L100 118 L28 86 Z" fill="#16a34a" />
            <path d="M180 70 L100 102 L100 118 L172 86 Z" fill="#15803d" />
            <path d="M28 86 L100 118 L172 86 L100 176 Z" fill="#78350f" />
            <rect x="64" y="40" width="8" height="26" fill="#7c2d12" />
            <circle cx="68" cy="36" r="16" fill="#22c55e" />
        </svg>
    </div>

    <div class="parallax" data-depth="0.3">
        <svg class="isle isle-far" viewBox="0 0 200 180">
            <path d="M20 70 L100 38 L180 70 L100 102 Z" fill="#a7f3d0" />
            <path d="M28 86 L100 118 L172 86 L100 176 Z" fill="#92400e" />
            <path d="M20 70 L100 102 L100 118 L28 86 Z" fill="#6ee7b7" />
            <path d="M180 70 L100 102 L100 118 L172 86 Z" fill="#34d399" />
        </svg>
    </div>

    <svg class="airship" viewBox="0 0 120 70">
        <ellipse cx="60" cy="24" rx="44" ry="18" fill="#fde68a" />
        <ellipse cx="60" cy="20" rx="40" ry="10" fill="#fef3c7" opacity="0.7" />
        <path d="M36 42 L84 42 L78 56 L42 56 Z" fill="#92400e" />
        <line x1="44" y1="38" x2="46" y2="42" stroke="#78350f" stroke-width="2" />
        <line x1="76" y1="38" x2="74" y2="42" stroke="#78350f" stroke-width="2" />
        <path d="M20 24 L6 14 L6 34 Z" fill="#f59e0b" />
    </svg>

    <div class="fireflies"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
</div>

<header class="topbar">
    <a class="brand" href="/">
        <svg viewBox="0 0 64 64" class="brand-mark" aria-hidden="true">
            <path d="M8 28 L32 18 L56 28 L32 38 Z" fill="#34d399" />
            <path d="M8 28 L32 38 L32 46 L14 36 Z" fill="#059669" />
            <path d="M56 28 L32 38 L32 46 L50 36 Z" fill="#047857" />
            <path d="M14 36 L32 46 L50 36 L32 60 Z" fill="#a16207" />
        </svg>
        <span class="brand-text">SkySaga</span>
        <span class="brand-tag">Infinite Isles</span>
    </a>
    <nav class="nav">
        <AuthorizeView>
            <Authorized>
                <a href="/" class="nav-link">Home</a>
                <a href="/account" class="nav-user">
                    <span class="nav-avatar">
                        @if (_avatar is { } avatar)
                        {
                            <img src="@PhotosApi.FileUrl(avatar)" alt="" />
                        }
                        else
                        {
                            @(context.User.Identity?.Name?[..1].ToUpperInvariant())
                        }
                    </span>
                    @context.User.Identity?.Name
                </a>
                <form method="post" action="/logout" class="inline">
                    <AntiforgeryToken />
                    <button type="submit" class="link-button">Sign out</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <a href="/login" class="nav-link">Sign in</a>
                <a href="/register" class="pill-button">Create account</a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</header>

<main class="content">
    @Body
</main>

<footer class="footer">
    <span>SkySaga: Infinite Isles</span>
    <span class="footer-dot">•</span>
    <span>community server</span>
</footer>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private Guid? _avatar;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not null && AccountClaims.AccountId(HttpContext.User) is { } id)
            _avatar = await Accounts.GetAvatarIdAsync(id);
    }
}
