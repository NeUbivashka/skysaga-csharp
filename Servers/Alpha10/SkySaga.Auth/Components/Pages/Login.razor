@page "/login"
@inject AccountService Accounts
@inject CommunityStats Stats
@inject NavigationManager Navigation

<PageTitle>Sign in · SkySaga</PageTitle>

<section class="auth-shell">
    <div class="auth-hero">
        <span class="kicker"><Icon Name="sparkle" /> Welcome back</span>
        <h1 class="display">The winds are <span class="gradient-text">in your favour</span>.</h1>
        <p class="lead">Sign in to manage your account, then fly on from the launcher.</p>
        <Motto />

        <div class="stat-row">
            <div class="stat live"><b data-count="@_community.Online">@_community.Online</b><span><i class="live-dot"></i>online now</span></div>
            <div class="stat"><b data-count="@_community.Isles">@_community.Isles</b><span>isles built</span></div>
            <div class="stat"><b data-count="@_community.Adventurers">@_community.Adventurers</b><span>adventurers</span></div>
        </div>
    </div>

    <div class="auth-card">
        <div class="auth-card-head">
            <h2>Sign in</h2>
            <p class="muted">Use your e-mail or your username.</p>
        </div>

        <EditForm Model="Input" FormName="login" OnValidSubmit="SubmitAsync" method="post" class="form" novalidate>
            <DataAnnotationsValidator />

            @if (_error is not null)
            {
                <div class="alert error">@_error</div>
            }

            <div class="field">
                <label for="login">E-mail or username</label>
                <div class="input-wrap">
                    <Icon Name="user" Class="input-icon" />
                    <InputText id="login" @bind-Value="Input.Username" autocomplete="username" maxlength="254" placeholder="you@example.com" autofocus />
                </div>
                <ValidationMessage For="() => Input.Username" />
            </div>

            <div class="field">
                <label for="password">Password</label>
                <div class="input-wrap">
                    <Icon Name="lock" Class="input-icon" />
                    <InputPassword id="password" @bind-Value="Input.Password" autocomplete="current-password" maxlength="128" placeholder="Your password" />
                    <button type="button" class="reveal" data-reveal="password" aria-label="Show password"><Icon Name="eye" /></button>
                </div>
                <ValidationMessage For="() => Input.Password" />
            </div>

            <button type="submit" class="button primary wide shine">
                Sign in <Icon Name="arrow" />
            </button>
        </EditForm>

        <div class="divider"><span>or</span></div>
        <a class="button ghost wide" href="/register">Create a new account</a>
        <p class="switch">Forgot the password? <a href="/reset">Use a reset code</a> from an admin.</p>
    </div>
</section>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "login")]
    private LoginModel Input { get; set; } = default!;

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string? _error;
    private Community _community = new(0, 0, 0);

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _community = await Stats.GetAsync();
    }

    private async Task SubmitAsync()
    {
        var (outcome, account) = await Accounts.LoginAsync(Input.Username, Input.Password);

        _error = outcome switch
        {
            LoginOutcome.Locked => "Too many wrong passwords. Try again in a few minutes.",
            LoginOutcome.Banned => (Forever.Is(account!.BannedUntil)
                                       ? "This account is banned permanently."
                                       : $"This account is banned until {account.BannedUntil?.ToLocalTime():yyyy-MM-dd HH:mm}.")
                                   + (string.IsNullOrWhiteSpace(account.BanReason) ? "" : $" Reason: {account.BanReason}"),
            LoginOutcome.Invalid => "The e-mail, username or password is wrong.",
            _ => null
        };

        if (_error is not null)
            return;

        await AccountClaims.SignInAsync(HttpContext, account!);
        Navigation.NavigateTo(ReturnUrl is { Length: > 1 } url && url.StartsWith('/') && !url.StartsWith("//") ? url : "/account");
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Enter your e-mail or username.")]
        public string Username { get; set; } = "";

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = "";
    }
}
