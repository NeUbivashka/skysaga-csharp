@page "/account"
@attribute [Authorize]
@inject AccountService Accounts
@inject NavigationManager Navigation

<PageTitle>Account · SkySaga</PageTitle>

@if (_account is not null)
{
    <div class="dashboard">
        @if (Welcome)
        {
            <div class="alert success glow">Welcome to the isles, <strong>@_account.Username</strong>! Open the launcher and sign in with these details.</div>
        }
        @if (_notice is not null)
        {
            <div class="alert success">@_notice</div>
        }

        <section class="profile-card">
            <div class="profile-banner"></div>
            <div class="profile-main">
                <div class="avatar-big">
                    @if (_avatar is { } avatar)
                    {
                        <img src="@PhotosApi.FileUrl(avatar)" alt="@_displayName" />
                    }
                    else
                    {
                        @_displayName[..1].ToUpperInvariant()
                    }
                </div>
                <div class="profile-text">
                    <h1>@_displayName</h1>
                    <div class="chips">
                        <span class="chip">@_account.Username</span>
                        <span class="chip role">@_account.Role</span>
                        @if (Forever.Is(_account.PremiumUntil))
                        {
                            <span class="vip forever"><Icon Name="crown" /> VIP forever</span>
                        }
                        else if (_account.PremiumUntil > DateTimeOffset.UtcNow)
                        {
                            <span class="vip"><Icon Name="crown" /> VIP until @_account.PremiumUntil.Value.ToLocalTime().ToString("d MMMM yyyy")</span>
                        }
                    </div>
                </div>
            </div>

            <div class="facts">
                <div class="fact"><Icon Name="user" /><span class="fact-label">Character</span><span class="fact-value">@(_character is { IsCustomised: true } ? _character.Name : "created on your first login")</span></div>
                <div class="fact"><Icon Name="mail" /><span class="fact-label">E-mail</span><span class="fact-value">@(_account.EmailHint ?? "not set")</span></div>
                <div class="fact"><Icon Name="sparkle" /><span class="fact-label">Member since</span><span class="fact-value">@_account.CreatedAt.ToLocalTime().ToString("d MMMM yyyy")</span></div>
                <div class="fact"><Icon Name="clock" /><span class="fact-label">Last sign-in</span><span class="fact-value">@(_account.LastLoginAt?.ToLocalTime().ToString("d MMMM yyyy, HH:mm") ?? "never")</span></div>
                <div class="fact"><Icon Name="globe" /><span class="fact-label">Last seen in game</span><span class="fact-value">@(_character?.LastSeenAt?.ToLocalTime().ToString("d MMMM yyyy, HH:mm") ?? "not yet")</span></div>
            </div>
        </section>

        <section class="panel">
            <h2><Icon Name="launch" /> How to play</h2>
            <ol class="play-steps">
                <li><span>1</span><div>Start <code>Launcher.exe</code>.</div></li>
                <li><span>2</span><div>Sign in with @(_account.EmailHint is null ? "your username" : "your e-mail") and password. The username <strong>@_account.Username</strong> works too.</div></li>
                <li><span>3</span><div>Press <strong>Play</strong> and take off.</div></li>
            </ol>
        </section>

        <div class="panel-grid">
            <section class="panel">
                <h2><Icon Name="mail" /> @(_account.EmailHint is null ? "Add e-mail" : "Change e-mail")</h2>
                <EditForm Model="Email" FormName="email" OnValidSubmit="SetEmailAsync" method="post" class="form" novalidate>
                    <DataAnnotationsValidator />

                    @if (_emailError is not null)
                    {
                        <div class="alert error">@_emailError</div>
                    }

                    <div class="field">
                        <label for="new-email">New e-mail</label>
                        <div class="input-wrap">
                            <Icon Name="mail" Class="input-icon" />
                            <InputText id="new-email" type="email" @bind-Value="Email.Address" autocomplete="email" maxlength="254" placeholder="you@example.com" />
                        </div>
                        <ValidationMessage For="() => Email.Address" />
                    </div>

                    <div class="field">
                        <label for="email-password">Password</label>
                        <div class="input-wrap">
                            <Icon Name="lock" Class="input-icon" />
                            <InputPassword id="email-password" @bind-Value="Email.Password" autocomplete="current-password" maxlength="128" placeholder="Your password" />
                        </div>
                        <ValidationMessage For="() => Email.Password" />
                    </div>

                    <button type="submit" class="button primary">Save e-mail</button>
                </EditForm>
            </section>

            <section class="panel">
                <h2><Icon Name="lock" /> Change password</h2>
                <EditForm Model="Password" FormName="password" OnValidSubmit="ChangePasswordAsync" method="post" class="form" novalidate>
                    <DataAnnotationsValidator />

                    @if (_passwordError is not null)
                    {
                        <div class="alert error">@_passwordError</div>
                    }

                    <input type="text" name="username" value="@_account.Username" autocomplete="username" hidden />

                    <div class="field">
                        <label for="current">Current password</label>
                        <div class="input-wrap">
                            <Icon Name="lock" Class="input-icon" />
                            <InputPassword id="current" @bind-Value="Password.Current" autocomplete="current-password" maxlength="128" />
                        </div>
                        <ValidationMessage For="() => Password.Current" />
                    </div>

                    <div class="field">
                        <label for="next">New password</label>
                        <div class="input-wrap">
                            <Icon Name="key" Class="input-icon" />
                            <InputPassword id="next" @bind-Value="Password.Next" autocomplete="new-password" maxlength="128" data-strength="next-strength" />
                            <button type="button" class="reveal" data-reveal="next" aria-label="Show password"><Icon Name="eye" /></button>
                        </div>
                        <div class="strength" id="next-strength" data-min="@AccountService.MinPasswordLength">
                            <div class="strength-bars"><span></span><span></span><span></span><span></span></div>
                            <small class="strength-label">Use at least @AccountService.MinPasswordLength characters.</small>
                        </div>
                        <ValidationMessage For="() => Password.Next" />
                    </div>

                    <div class="field">
                        <label for="repeat">Repeat new password</label>
                        <div class="input-wrap">
                            <Icon Name="key" Class="input-icon" />
                            <InputPassword id="repeat" @bind-Value="Password.Confirm" autocomplete="new-password" maxlength="128" data-match="next" />
                            <span class="match-mark"><Icon Name="check" /></span>
                        </div>
                        <ValidationMessage For="() => Password.Confirm" />
                    </div>

                    <button type="submit" class="button primary">Change password</button>
                </EditForm>
            </section>
        </div>

        <section class="panel danger-zone">
            <div>
                <h2><Icon Name="logout" /> Sign out everywhere</h2>
                <p class="muted">Ends every session of this account: the launcher, the game and other browsers.</p>
            </div>
            <form method="post" @formname="everywhere" @onsubmit="SignOutEverywhereAsync">
                <AntiforgeryToken />
                <button type="submit" class="button danger">Sign out everywhere</button>
            </form>
        </section>
    </div>
}

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "welcome")] private int? WelcomeFlag { get; set; }

    [SupplyParameterFromForm(FormName = "password")]
    private PasswordModel Password { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "email")]
    private EmailModel Email { get; set; } = default!;

    private bool Welcome => WelcomeFlag == 1;
    private Account? _account;
    private Character? _character;
    private Guid? _avatar;
    private string _displayName = "?";
    private string? _passwordError;
    private string? _emailError;
    private string? _notice;

    protected override async Task OnInitializedAsync()
    {
        Password ??= new();
        Email ??= new();

        if (AccountClaims.AccountId(HttpContext.User) is not { } id || await Accounts.GetAccountAsync(id) is not { } account)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        _account = account;
        _character = await Accounts.GetCharacterAsync(id);
        _avatar = await Accounts.GetAvatarIdAsync(id);
        _displayName = _character is { IsCustomised: true } ? _character.Name : account.Username;
    }

    private async Task ChangePasswordAsync()
    {
        _passwordError = await Accounts.ChangePasswordAsync(_account!.Id, Password.Current, Password.Next);

        if (_passwordError is not null)
            return;

        await AccountClaims.SignInAsync(HttpContext, (await Accounts.GetAccountAsync(_account.Id))!);
        _notice = "Password changed. Other sessions were signed out.";
        Password = new();
    }

    private async Task SetEmailAsync()
    {
        var (_, error) = await Accounts.SetEmailAsync(_account!.Id, Email.Address, Email.Password);

        if (error is not null)
        {
            _emailError = error;
            return;
        }

        _account = await Accounts.GetAccountAsync(_account.Id);
        _notice = "E-mail saved.";
        Email = new();
    }

    private async Task SignOutEverywhereAsync()
    {
        await Accounts.SignOutEverywhereAsync(_account!.Id);
        await HttpContext.SignOutAsync();
        Navigation.NavigateTo("/login");
    }

    private sealed class EmailModel
    {
        [Required(ErrorMessage = "Enter the e-mail.")]
        public string Address { get; set; } = "";

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = "";
    }

    private sealed class PasswordModel
    {
        [Required(ErrorMessage = "Enter your current password.")]
        public string Current { get; set; } = "";

        [Required(ErrorMessage = "Enter a new password.")]
        public string Next { get; set; } = "";

        [Required(ErrorMessage = "Repeat the new password.")]
        [Compare(nameof(Next), ErrorMessage = "The passwords do not match.")]
        public string Confirm { get; set; } = "";
    }
}
